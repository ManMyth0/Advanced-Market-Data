{
  "AppConfiguration": {
    "AssetPairsFile": "asset-pairs.txt",
    "DefaultChannels": ["candles"],
    "RunMode": "live-only",
    "GranularitySeconds": 300,
    "MaxConcurrentSubscriptions": 4,
    "AllowManualOverride": true,
    "PromptForApiSetup": true,
    "AutoExportOnExit": true,
    "PromptForExportIfDisabled": true,
    "EnableRealTimeExport": false,
    "CsvExportPath": "candles.csv",
    "LocalApi": {
      "Enabled": false,
      "ApiOnlyMode": true,
      "Host": "127.0.0.1",
      "Port": 5058,
      "AuditLog": {
        "Directory": "logs",
        "RetentionDays": 31
      }
    },
    "MaxCandlesInMemory": {
      "Enabled": true,
      "Amount": 5000
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
